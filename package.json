{
  "name": "analog-synth-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "dev:server": "tsx --env-file=.env server/index.ts",
    "start": "node server-dist/index.js",
    "build:mobile-local": "tsc --noEmit && vite build --mode mobile-local && cap sync android",
    "test": "node --import tsx --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.1",
    "@capacitor/core": "^8.1.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.4",
    "@react-oauth/google": "^0.12.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
